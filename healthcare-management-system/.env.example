# Root-level reference. Real values go in backend/.env and frontend/.env (never commit them).

# ---- backend/.env ----
MONGO_URL="mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority"
DB_NAME="healthcare_db"
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="<generate-a-long-random-hex-string>"
JWT_EXPIRE_HOURS="12"
ADMIN_EMAIL="<admin-email>"
ADMIN_PASSWORD="<strong-admin-password>"
SEED_DEMO_DATA="true"
DEMO_DOCTOR_PASSWORD="<demo-doctor-password>"
DEMO_PATIENT_PASSWORD="<demo-patient-password>"
APP_TIMEZONE="UTC"
AI_PROVIDER="demo"
AI_MODEL=""
AI_API_KEY=""
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# ---- frontend/.env ----
REACT_APP_BACKEND_URL=http://localhost:8001
